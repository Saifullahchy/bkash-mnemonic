NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# MongoDB (docker compose up -d mongo)
MONGODB_URI=mongodb://localhost:27017/offer_finder

# Comma-separated list of allowed browser origins (offer site + admin panel)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Number of reverse proxies in front of the API (0 locally, 1 behind a load balancer).
# Required for correct client IPs in rate limiting and anti-abuse checks.
TRUST_PROXY=0

# Shared by api, web and admin (same value in all three). Lets the API trust the visitor IP that
# the web/admin servers pass along. Required in production.
PROXY_SECRET=

# Global rate limit for /v1 (per IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=300

# Shared Redis for rate limits, so limits hold across API instances (npm run db:up starts one).
# Empty = in-memory limits (fine for a single instance). If Redis goes down, limits fail open
# and the DB-backed counting rules still protect the counts.
REDIS_URL=redis://localhost:6379

# Used by `npm run seed` to build demo banner/prize image URLs (served by the web app)
SEED_ASSET_BASE_URL=http://localhost:3000

# Offer site origin used to build share links: ${PUBLIC_SITE_URL}/s/{code}
PUBLIC_SITE_URL=http://localhost:3000

# Participant sessions (httpOnly cookie JWT). Generate with:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
SESSION_SECRET=change-me-to-a-long-random-string-of-48-bytes
SESSION_TTL_DAYS=30
# Leave empty: the browser only talks to the web/admin sites, so cookies belong to those hosts.
COOKIE_DOMAIN=
# Defaults to true in production
# COOKIE_SECURE=true

# Unique-open counting (generate each like SESSION_SECRET; never reuse secrets)
# Signs the short-lived single-use token embedded in the /s/{code} landing page
OPEN_TOKEN_SECRET=change-me-to-another-long-random-string
# Salt for device/subnet hashes (raw IPs are never stored). Changing it resets duplicate detection.
FINGERPRINT_SALT=change-me-to-a-random-salt

# Admin panel sessions (separate secret from participants). Generate like SESSION_SECRET.
ADMIN_SESSION_SECRET=change-me-to-a-third-long-random-string
ADMIN_SESSION_TTL_HOURS=8
ADMIN_REMEMBER_DAYS=30

# Image storage. With an ImageKit private key, uploads go to ImageKit and its URLs are saved
# in the database; without one they go to UPLOAD_DIR and are served at /uploads.
# STORAGE_DRIVER=local|imagekit forces one. Keep the private key out of git and out of web/admin.
STORAGE_DRIVER=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/yyzpkkigy
IMAGEKIT_FOLDER=offer-finder
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# `npm run seed` creates this admin if it doesn't exist (local/dev only)
SEED_ADMIN_EMAIL=admin@mnemonic.local
SEED_ADMIN_PASSWORD=choose-a-strong-password

# Scheduled email reports. Empty = development transport: emails + attachments
# are written to MAIL_OUTBOX_DIR instead of being sent.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Mnemonic Reports <reports@offer-finder.com>"
MAIL_OUTBOX_DIR=./outbox
