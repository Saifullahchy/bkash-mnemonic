{
  "name": "offer-finder-api",
  "version": "0.1.0",
  "description": "Offer Finder API (api.offer-finder.com)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:up": "docker compose up -d mongo redis",
    "db:down": "docker compose down",
    "admin:create": "tsx --env-file-if-exists=.env src/scripts/createAdmin.ts",
    "images:migrate": "tsx --env-file-if-exists=.env src/scripts/migrateImages.ts",
    "stats:rebuild": "tsx --env-file-if-exists=.env src/scripts/rebuildStats.ts",
    "db:indexes": "tsx --env-file-if-exists=.env src/scripts/syncIndexes.ts",
    "seed:demo": "tsx --env-file-if-exists=.env src/scripts/seedDemoActivity.ts"
  },
  "type": "module",
  "private": "true",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "image-size": "^2.1.0",
    "isbot": "^5.2.3",
    "jose": "^6.2.18",
    "mongoose": "^9.12.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.4.0",
    "sanitize-html": "^2.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "mongodb-memory-server": "^11.4.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
