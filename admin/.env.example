# Public URL of the offer site (shown in share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API as seen from the admin server (never sent to the browser)
API_URL=http://localhost:4000/v1
# Same value as PROXY_SECRET in api/.env
PROXY_SECRET=
# Header in which the proxy or platform in front reports the visitor's IP, e.g. x-real-ip (nginx)
# or cf-connecting-ip (Cloudflare). Empty locally.
CLIENT_IP_HEADER=
# Comma-separated URL patterns allowed for images (ImageKit)
IMAGE_REMOTE_PATTERNS=https://ik.imagekit.io/yyzpkkigy/**
